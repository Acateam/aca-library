rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace example\\.com with your company domain (e.g. dolenglish\\.vn).
    function companyUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('^[^@]+@ieltsdinhluc\\.vn$');
    }
    function rolePath() { return /databases/$(database)/documents/roles/$(request.auth.token.email.lower()); }
    function admin() { return companyUser() && exists(rolePath()) && get(rolePath()).data.role in ['admin','owner']; }
    function owner() { return companyUser() && exists(rolePath()) && get(rolePath()).data.role == 'owner'; }
    function text(d,k,max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function linkAt(list,i) {
      return list.size() <= i || (list[i] is map && list[i].keys().hasOnly(['label','url'])
        && list[i].label is string && list[i].label.size() > 0 && list[i].label.size() <= 80
        && list[i].url is string && list[i].url.size() <= 2048 && list[i].url.matches('^https://.+'));
    }
    function links(d) {
      return !('relatedLinks' in d) || (d.relatedLinks is list && d.relatedLinks.size() <= 10
        && linkAt(d.relatedLinks,0) && linkAt(d.relatedLinks,1) && linkAt(d.relatedLinks,2)
        && linkAt(d.relatedLinks,3) && linkAt(d.relatedLinks,4) && linkAt(d.relatedLinks,5)
        && linkAt(d.relatedLinks,6) && linkAt(d.relatedLinks,7) && linkAt(d.relatedLinks,8) && linkAt(d.relatedLinks,9));
    }
    function validNode(d) {
      return d.keys().hasOnly(['kind','name','parentId','url','icon','createdAt','updatedAt','description','team','task','type','status','maintainer','keywords','relatedLinks'])
        && d.kind in ['folder','link'] && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && (d.parentId == null || d.parentId is string)
        && d.url is string && d.url.size() <= 2048
        && ((d.kind == 'folder' && d.url == '') || (d.kind == 'link' && d.url.matches('^https://.+')))
        && text(d,'icon',20) && text(d,'description',600) && text(d,'team',200) && text(d,'task',200)
        && text(d,'maintainer',200) && text(d,'keywords',200)
        && (!('type' in d) || d.type in ['Web app','Google Sheet','Apps Script','Guide','Other'])
        && (!('status' in d) || d.status in ['Active','Under maintenance','Archived']) && links(d);
    }
    match /nodes/{id} {
      allow read: if companyUser();
      allow create: if admin() && validNode(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && (request.resource.data.parentId == null || (exists(/databases/$(database)/documents/nodes/$(request.resource.data.parentId))
          && get(/databases/$(database)/documents/nodes/$(request.resource.data.parentId)).data.kind == 'folder'));
      allow update: if admin() && validNode(request.resource.data)
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.updatedAt == request.time
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt'])
        && (request.resource.data.parentId == resource.data.parentId || (resource.data.kind == 'link'
          && (request.resource.data.parentId == null || (exists(/databases/$(database)/documents/nodes/$(request.resource.data.parentId))
          && get(/databases/$(database)/documents/nodes/$(request.resource.data.parentId)).data.kind == 'folder'))));
      // Archive / restore replaces destructive deletion in v2.
      allow delete: if false;
    }
    match /profiles/{uid} {
      allow get: if companyUser() && request.auth.uid == uid;
      allow create, update: if companyUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname','avatar','defaultTeam','pins','recent'])
        && text(request.resource.data,'nickname',200) && text(request.resource.data,'defaultTeam',200)
        && (!('avatar' in request.resource.data) || (request.resource.data.avatar is int && request.resource.data.avatar >= 0 && request.resource.data.avatar < 6))
        && (!('pins' in request.resource.data) || (request.resource.data.pins is list && request.resource.data.pins.size() <= 100))
        && (!('recent' in request.resource.data) || (request.resource.data.recent is list && request.resource.data.recent.size() <= 12));
      allow list, delete: if false;
    }
    match /roles/{email} {
      allow get: if companyUser() && (request.auth.token.email.lower() == email || owner());
      allow list: if owner();
      allow create: if owner() && request.resource.data.keys().hasOnly(['role']) && request.resource.data.role == 'admin'
        && email.matches('^[^@]+@ieltsdinhluc\\.vn$');
      allow delete: if owner() && resource.data.role == 'admin';
      allow update: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
